+    def _get_retract_params(self, gcmd):
+        mode = gcmd.get('PROBE_RETRACT_MODE', self.probe_retract_mode).lower()
+        if mode not in ('fixed', 'adaptive'):
+            raise gcmd.error("PROBE_RETRACT_MODE must be fixed or adaptive")
+        clearance = gcmd.get_float('PROBE_RELEASE_CLEARANCE',
+                                  self.probe_release_clearance, minval=0.)
+        max_dist = gcmd.get_float('PROBE_RELEASE_MAX_DIST',
+                                 self.probe_release_max_dist, above=0.)
+        speed = gcmd.get_float('PROBE_RELEASE_SPEED',
+                              self.probe_release_speed, above=0.)
+        if not all(math.isfinite(v) for v in (clearance, max_dist, speed)):
+            raise gcmd.error("Probe release settings must be finite")
+        sync = gcmd.get('PROBE_RELEASE_SYNC', 'queued').lower()
+        if sync not in ('legacy', 'optimized', 'queued'):
+            raise gcmd.error("PROBE_RELEASE_SYNC must be legacy, optimized or queued")
+        return mode, clearance, max_dist, speed, sync
+
