+    def _adaptive_retract(self, gcmd, contact, label, retract):
+        _, clearance, max_dist, speed, sync = retract
+        toolhead = self.printer.lookup_object('toolhead')
+        clock = self.printer.get_reactor().monotonic
+        t0 = clock()
+        # _probe() has already waited for the MCU stop and actual step positions.
+        # Avoid flushing/repriming that completed move merely to read the pin.
+        if sync == 'legacy':
+            toolhead.wait_moves()
+        t1 = clock()
+        start = toolhead.get_position()
+        now = clock()
+        zmax = toolhead.get_status(now)['axis_maximum'][2]
+        if start[2] + max_dist + clearance > zmax:
+            raise gcmd.error("Adaptive retract would exceed Z travel limit")
+        query_time = (toolhead.get_last_move_time() if sync == 'legacy' else
+                      self.mcu_probe.get_mcu().estimated_print_time(clock()))
+        if not self.mcu_probe.query_endstop(query_time):
+            self._log_release(gcmd, 
+                'PROBE_RELEASE %s X=%.4f Y=%.4f contact_z=%.5f '
+                'halt_z=%.5f state=already_clear' %
+                (label, contact[0], contact[1], contact[2], start[2]))
+            raise gcmd.error(
+                "Probe already clear after contact; release height unknown. "
+                "Use fixed retract mode until the signal is verified.")
+        t2 = clock()
+        target = list(start)
+        target[2] += max_dist
+        hmove = homing.HomingMove(self.printer, [(self.mcu_probe, 'probe')])
+        try:
+            release = hmove.homing_move(target, speed, probe_pos=True,
+                                       triggered=False, check_triggered=True)
+        except self.printer.command_error:
+            self._log_release(gcmd, 
+                'PROBE_RELEASE %s X=%.4f Y=%.4f contact_z=%.5f '
+                'state=release_failed max_dist=%.5f' %
+                (label, contact[0], contact[1], contact[2], max_dist))
+            raise
+        t3 = clock()
+        halt_z = toolhead.get_position()[2]
+        final_z = halt_z + clearance
+        if final_z > zmax:
+            raise gcmd.error("Adaptive retract clearance exceeds Z travel")
+        queued_end = None
+        if clearance == 0. and sync == 'queued':
+            # The release homing move has already stopped at halt_z. Preserve
+            # 20 ms settling without priming a new, empty motion-buffer window.
+            reactor = self.printer.get_reactor()
+            reactor.pause(clock() + 0.020)
+        else:
+            toolhead.manual_move([None, None, final_z], speed)
+            toolhead.dwell(0.020)
+            if sync == 'queued':
+                # Schedule the check after actual clearance motion and dwell.
+                queued_end = toolhead.get_last_move_time()
+            else:
+                toolhead.wait_moves()
+        t4 = clock()
+        # Motion and the settling dwell are complete. A current-time query
+        # checks release without starting another future motion-buffer window.
+        query_time = (queued_end if queued_end is not None else
+                      toolhead.get_last_move_time() if sync == 'legacy' else
+                      self.mcu_probe.get_mcu().estimated_print_time(clock()))
+        pin_state = self.mcu_probe.query_endstop(query_time)
+        remaining = 0.
+        if queued_end is not None:
+            remaining = queued_end - self.mcu_probe.get_mcu().estimated_print_time(clock())
+            if remaining > 0.:
+                # A query that returns before physical completion is not a
+                # valid post-clearance check. Finish the move and sample again.
+                toolhead.wait_moves()
+                pin_state = self.mcu_probe.query_endstop(
+                    self.mcu_probe.get_mcu().estimated_print_time(clock()))
+        if pin_state:
+            self._log_release(gcmd, 
+                'PROBE_RELEASE %s contact_z=%.5f release_z=%.5f '
+                'final_z=%.5f state=retriggered' %
+                (label, contact[2], release[2], final_z))
+            raise gcmd.error("Probe re-triggered after adaptive clearance")
+        t5 = clock()
+        self._log_release(gcmd, 
+            'PROBE_RELEASE %s X=%.4f Y=%.4f contact_z=%.5f '
+            'release_z=%.5f release_delta=%.5f halt_z=%.5f '
+            'final_z=%.5f clearance=%.5f start_z=%.5f speed=%.3f sync=%s '
+            'wait_before_ms=%.1f check_before_ms=%.1f release_move_ms=%.1f '
+            'clearance_wait_ms=%.1f check_after_ms=%.1f total_ms=%.1f '
+            'post_remaining_ms=%.1f' %
+            (label, contact[0], contact[1], contact[2], release[2],
+             release[2] - contact[2], halt_z, final_z, clearance, start[2],
+             speed, sync, 1000*(t1-t0), 1000*(t2-t1), 1000*(t3-t2),
+             1000*(t4-t3), 1000*(t5-t4), 1000*(t5-t0), 1000*remaining))
